{
  "name": "@pr-reviewer/cli",
  "version": "0.1.0",
  "description": "Review GitHub pull requests with deterministic checks and the AI provider of your choice.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "pr-reviewer": "./bin/pr-reviewer.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@pr-reviewer/core": "workspace:*",
    "@pr-reviewer/credentials": "workspace:*",
    "@pr-reviewer/github": "workspace:*",
    "@pr-reviewer/providers": "workspace:*",
    "@pr-reviewer/validators": "workspace:*",
    "yaml": "2.9.1"
  }
}
